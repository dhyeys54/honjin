{
  "private": true,
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "scripts": {
    "build:browser": "npm --prefix browser-app run bundle",
    "build:electron": "npm --prefix electron-app run bundle",
    "prepare": "lerna run prepare",
    "postinstall": "theia check:theia-version",
    "start:browser": "npm --prefix browser-app start",
    "start:electron": "npm --prefix electron-app start",
    "watch:browser": "lerna run --parallel watch --ignore electron-app",
    "watch:electron": "lerna run --parallel watch --ignore browser-app",
    "build": "npm run build -w honjin-core",
    "test": "jest -c honjin-core/test/jest.config.ts",
    "test:int": "jest -c honjin-core/test/jest.int.config.ts --passWithNoTests",
    "test:plugin": "npm --prefix herdr-plugin test",
    "test:install": "sh scripts/install.test.sh",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit -p honjin-core",
    "lint": "eslint .",
    "package:mac": "npm run build -w honjin-core && npm --prefix electron-app run download:plugins && npm --prefix electron-app run rebuild && cd electron-app && rm -rf lib && theia build --mode production && electron-builder --mac",
    "download:plugins": "npm --prefix browser-app run download:plugins"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@theia/playwright": "1.76.0",
    "eslint": "^9.39.5",
    "lerna": "^8.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "workspaces": [
    "honjin-core",
    "browser-app",
    "electron-app"
  ]
}
